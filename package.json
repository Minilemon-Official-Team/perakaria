{
  "name": "perakaria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "website",
    "cms-admin",
    "cms-api",
    "shared/content-schema"
  ],
  "scripts": {
    "dev:website": "npm run dev --workspace website",
    "dev:cms": "npm run dev --workspace cms-admin",
    "dev:api": "npm run dev --workspace cms-api",
    "build": "npm run build --workspace @perakaria/content-schema && npm run build --workspace cms-api && npm run build --workspace website && npm run build --workspace cms-admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "impeccable:check": "npx impeccable check",
    "impeccable:audit": "npx impeccable detect website/src cms-admin/src"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
