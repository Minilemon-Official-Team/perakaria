{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "perakaria-cms-api",
  "account_id": "2233424a9945a9540de3d7f456eb640e",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production",
    "CMS_ALLOWED_ORIGINS": "https://perakaria-site.minilemon-tech.workers.dev,https://perakaria-cms.minilemon-tech.workers.dev",
    "PUBLIC_ASSET_BASE_URL": "https://perakaria-cms-api.minilemon-tech.workers.dev/assets"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "perakaria_cms_db",
      "database_id": "57f30bf7-9ec5-43fb-9a23-5d1c105d212c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "perakaria-cms-assets"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}