{
  "name": "cms-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "cf-types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply perakaria_cms_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply perakaria_cms_db --remote",
    "startup": "wrangler check startup",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "@perakaria/content-schema": "0.1.0",
    "hono": "^4.12.32",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250628.0",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "4.25.0"
  }
}
